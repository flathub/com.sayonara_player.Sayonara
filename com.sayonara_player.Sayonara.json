{
    "app-id": "com.sayonara_player.Sayonara",
    "runtime": "org.kde.Platform",
    "runtime-version": "5.15-25.08",
    "sdk": "org.kde.Sdk",
    "command": "sayonara",
    "finish-args": [
        "--env=GST_PLUGIN_SYSTEM_PATH=/app/lib/gstreamer-1.0:/usr/lib/extensions/codecs-extra/lib/gstreamer-1.0:/usr/lib/x86_64-linux-gnu/gstreamer-1.0",
        "--share=ipc",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--socket=pulseaudio",
        "--share=network",
        "--filesystem=host",
        "--talk-name=org.freedesktop.Notifications",
        "--talk-name=org.mpris.MediaPlayer2.Player",
        "--own-name=org.mpris.MediaPlayer2.sayonara",
        "--talk-name=org.kde.StatusNotifierWatcher",    
        "--device=all"
    ],
    "rename-appdata-file": "com.sayonara-player.Sayonara.appdata.xml",
    "rename-desktop-file": "com.sayonara-player.Sayonara.desktop",
    "rename-icon": "sayonara",
    "modules": [
        {
            "buildsystem": "autotools",
            "name": "soundtouch",
            "sources": [
                {
                    "commit": "0047e0b1ecfceb041348579119bf79b73a322a3a",
                    "tag": "2.4.1",
                    "type": "git",
                    "url": "https://codeberg.org/soundtouch/soundtouch.git"
                }
            ]
        },
        {
            "name": "sayonara",
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "config-opts": [
                "-DCMAKE_INSTALL_PREFIX=/app",
                "-DCMAKE_BUILD_TYPE=Release"
            ],
            "sources": [
                {
                    "commit": "f9cd12c227af2709801776781b60f4e603edd4d5",
                    "type": "git",
                    "url": "https://gitlab.com/luciocarreras/sayonara-player.git",
                    "tag": "1.12.0-stable1"
                }
            ]
        }
    ]
}
